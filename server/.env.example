# Copy to .env and fill in. `docker compose` reads .env automatically.

# TLS and the hostname are handled by the Caddy already running on this VPS —
# see Caddyfile.snippet. Nothing here configures it.

# The shared secret the register sends. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the same value into Configuración -> Sincronización -> CLAVE.
POS_SYNC_KEY=

# --- Reports ---------------------------------------------------------------
# The shop's own timezone. Sales are stored as UTC instants, but "ventas del
# martes" is a question about the calendar on the wall: without this, every sale
# after 6pm is filed under the next day and both days come out wrong.
POS_TZ=America/Mexico_City

# --- Backups ---------------------------------------------------------------
# Units: s, m, h, d. 5m now; switch to 1d once the shop has settled.
POS_BACKUP_ENABLED=1
POS_BACKUP_INTERVAL=5m
POS_BACKUP_KEEP=48

# --- Purging ---------------------------------------------------------------
# OFF by default: this deletes sales history permanently. A backup is taken
# immediately before every purge, and the purge aborts if that backup fails.
POS_PURGE_ENABLED=0
POS_PURGE_INTERVAL=1d
POS_PURGE_DAYS=365
POS_PURGE_CHANGES_DAYS=30
POS_STALE_STORE_DAYS=30
